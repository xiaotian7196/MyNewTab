{
  "manifest_version": 3,
  "name": "Homepage",
  "version": "1.0.0",
  "description": "A private customizable new tab homepage with multi-engine search suggestions.",
  "browser_specific_settings": {
    "gecko": {
      "id": "homepage-liquid-glass@example.local",
      "strict_min_version": "109.0"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.baidu.com/*",
    "https://suggestion.baidu.com/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*",
    "https://www.sogou.com/*",
    "https://www.so.com/*",
    "https://icons.duckduckgo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Homepage",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
